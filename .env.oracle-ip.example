ENVIRONMENT=staging
APP_NAME=Educa Suite

POSTGRES_DB=educa_suite
POSTGRES_USER=educa_suite
POSTGRES_PASSWORD=cambia-esta-password-larga

DATABASE_URL=postgresql+psycopg://educa_suite:cambia-esta-password-larga@postgres:5432/educa_suite
JWT_SECRET=cambia-este-secreto-muy-largo-de-32-caracteres-minimo
COOKIE_SECURE=false

# Sustituye TU_IP_PUBLICA por la IP publica del VPS.
# Sin dominio ni HTTPS, usa staging y cookie segura desactivada.
CORS_ORIGINS=http://TU_IP_PUBLICA,http://TU_IP_PUBLICA:8890,http://TU_IP_PUBLICA:5174
SITE_ADDRESS=:80
ACME_EMAIL=admin@example.com

# Para arrancar barato puedes usar groq. Para correcciones mas finas, openai.
AI_PROVIDER=groq
OPENAI_API_KEY=
GROQ_API_KEY=
CHAT_MODEL=openai/gpt-oss-120b
TRANSCRIBE_MODEL=whisper-large-v3-turbo
MAX_OUTPUT_TOKENS=3200
MAX_VOCAB=3
PROFILE_CHARS=420

# Google Drive/OAuth puede quedar vacio durante la primera subida por IP.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://TU_IP_PUBLICA/auth/google/callback
GOOGLE_SIGNUP_LICENSE_DAYS=365
GOOGLE_SIGNUP_USAGE_LIMIT=300

SUPERADMIN_EMAIL=admin@tudominio.local
SUPERADMIN_PASSWORD=cambia-esta-password-admin
