POSTGRES_DB=educa_suite
POSTGRES_USER=educa_suite
POSTGRES_PASSWORD=cambia-esta-password

DATABASE_URL=postgresql+psycopg://educa_suite:cambia-esta-password@postgres:5432/educa_suite
JWT_SECRET=cambia-este-secreto-largo-de-32-caracteres-minimo
COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:8890,http://localhost:8890,http://127.0.0.1:5174,http://localhost:5174
SITE_ADDRESS=:80
ACME_EMAIL=admin@example.com

AI_PROVIDER=groq
OPENAI_API_KEY=
GROQ_API_KEY=
CHAT_MODEL=openai/gpt-oss-120b
TRANSCRIBE_MODEL=whisper-large-v3-turbo
MAX_OUTPUT_TOKENS=3200
MAX_VOCAB=3
PROFILE_CHARS=420

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Para educame.tech: https://educame.tech/auth/google/callback
# Debe coincidir exactamente con la URI autorizada en el cliente OAuth de Google.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8890/auth/google/callback
GOOGLE_SIGNUP_LICENSE_DAYS=365
GOOGLE_SIGNUP_USAGE_LIMIT=300

# Registro público de ESO: saldo inicial concedido una sola vez por cuenta.
ESO_SIGNUP_ENABLED=true
ESO_SIGNUP_CREDITS=100
ESO_SIGNUP_DAYS=365

# Nuevas cuentas de Profesor Particular; cambiar a PROFESOR_FREE solo afecta a altas futuras.
PROFESOR_SIGNUP_ENABLED=true
PROFESOR_SIGNUP_CREDITS=100
PROFESOR_SIGNUP_DAYS=365
PROFESOR_SIGNUP_PLAN=PROFESOR_FREE
# Número máximo de materiales generándose a la vez en todos los usuarios.
PROFESOR_GENERATION_MAX_CONCURRENT=3

SUPERADMIN_EMAIL=admin@educa-suite.local
SUPERADMIN_PASSWORD=cambia-esta-password

# OCR: modelo con vision; clave exclusivamente del servidor.
OCR_PROVIDER=
OCR_MODEL=
OCR_API_KEY=

# Correo de cuentas. Sin SMTP, las altas por correo se desactivan; Google sigue disponible.
PUBLIC_BASE_URL=http://127.0.0.1:8890
ALLOWED_HOSTS=localhost,127.0.0.1,backend,educame.tech,www.educame.tech
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
# Generada una sola vez por deploy-hostinger.sh; conservar fuera de la base junto con .env.
OAUTH_TOKEN_ENCRYPTION_KEY=
MAX_STATE_BYTES=8000000
# Coste operativo opcional: tarifas reales por millón de tokens, por modelo.
AI_MODEL_PRICES_JSON={}
AI_MONTHLY_BUDGET_USD=0
